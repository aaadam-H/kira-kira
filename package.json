{
  "name": "kira-kira",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:single": "vite build --mode single",
    "test:questions": "node scripts/test-questions.js",
    "android:setup": "node scripts/setup-android.mjs",
    "android:sync": "npm run build && npx cap sync android",
